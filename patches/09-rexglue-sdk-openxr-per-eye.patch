+// DK_XR=1 (patch 09, 2026-10-15): hand the pair ComposeSideBySidePair just laid out to an OpenXR
+// headset. Off unless DK_XR=1 (and it needs DK_SBS=1 for the pair). xr_output.cpp has the rest.
+void D3D12CommandProcessor::SubmitPairToHeadset() {
+  using rex::graphics::d3d12::XrOutput;
+  if (!xr_ready_ || !XrOutput::Wanted()) return;
+  xr_ready_ = false;
+  XrOutput& xr = XrOutput::Get();
+  static bool log_set = [&xr] {
+    xr.SetLog([](const char* line) { REXGPU_INFO("{}", line); });
+    return true;
+  }();
+  (void)log_set;
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Resource* left = xr_mono_ ? xr_mono_.Get() : sbs_eye_[0].Get();
+  ID3D12Resource* right = xr_mono_ ? xr_mono_.Get() : sbs_eye_[1].Get();
+  if (left && right) {
+    xr.SubmitPair(provider.GetDevice(), provider.GetDirectQueue(), left, right, sbs_width_,
+                  sbs_height_, D3D12_RESOURCE_STATE_COPY_SOURCE, xr_pair_);
+  }
+  xr_mono_.Reset();
+}
