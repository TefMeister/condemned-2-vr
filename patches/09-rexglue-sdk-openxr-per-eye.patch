diff --git b/include/rex/graphics/d3d12/xr_output.h b/include/rex/graphics/d3d12/xr_output.h
new file mode 100644
index 0000000..2cb90d0
--- /dev/null
+++ b/include/rex/graphics/d3d12/xr_output.h
@@ -0,0 +1,51 @@
+// DK_XR=1 (Condemned 2 / Darkness VR, patch 09, 2026-10-15): hand each eye of the side-by-side pair
+// to an OpenXR headset. Rides on DK_SBS=1: the eye textures it sends are the ones patch 08b fills.
+//
+// Off unless DK_XR=1, so a build without the switch behaves exactly as before. Self-contained on
+// purpose (Windows, D3D12 and the OpenXR headers only), so tests can drive it without the SDK.
+//
+// Threads: SubmitPair runs on the GPU (command processor) thread. rex_xr_sample_head (exported
+// below) is called by the game program from its own frame thread; the two share only a small
+// locked ring of head samples.
+#pragma once
+
+#include <cstdint>
+
+#include <windows.h>
+#include <d3d12.h>
+
+namespace rex::graphics::d3d12 {
+
+class XrOutput {
+ public:
+  using LogFn = void (*)(const char* line);
+
+  static XrOutput& Get();
+  // DK_XR=1 in the environment.
+  static bool Wanted();
+
+  void SetLog(LogFn fn) { log_ = fn; }
+
+  // Send one stereo pair. left/right are W x H textures resting in `state`; they are read after
+  // everything already submitted to `queue`, and left in `state` again. pair numbers the pair the
+  // same way the game program does (its present count / (2 * period)), so the head sample the game
+  // rendered it with can be found; pass UINT32_MAX when the picture has no pair (a mono swap).
+  void SubmitPair(ID3D12Device* device, ID3D12CommandQueue* queue, ID3D12Resource* left,
+                  ID3D12Resource* right, uint32_t width, uint32_t height,
+                  D3D12_RESOURCE_STATES state, uint32_t pair);
+
+  void Log(const char* fmt, ...);
+
+ private:
+  LogFn log_ = nullptr;
+};
+
+}  // namespace rex::graphics::d3d12
+
+// For the game program (it looks these up with GetProcAddress on rexgpu-xenos.dll).
+// Samples the headset now and keeps the sample for the frame that will show it. Writes a sample id
+// (hand it back through dk_xr_pair_sample), the head's orientation (x, y, z, w) and position
+// (metres) in OpenXR's local space: +X right, +Y up, -Z forward, right-handed. Returns 1 when the
+// headset is tracking, 0 otherwise (outputs then hold identity).
+extern "C" __declspec(dllexport) int rex_xr_sample_head(uint32_t* id_out, float orient_xyzw[4],
+                                                        float pos_xyz[3]);
