diff --git b/tests/dk_xr/xr_host_test.cpp b/tests/dk_xr/xr_host_test.cpp
new file mode 100644
index 0000000..82623f7
--- /dev/null
+++ b/tests/dk_xr/xr_host_test.cpp
@@ -0,0 +1,150 @@
+// Patch 09 (DK_XR) test host: drives xr_output.cpp + xr_blit.cpp exactly as the SDK does, with no
+// game. Two flat-coloured eye textures (left red, right blue, 10:10:10:2 like the game's output)
+// are sent for N frames to whatever OpenXR runtime XR_RUNTIME_JSON names (the simulator on the dev
+// PC). The host also plays the game program's part: it exports dk_xr_eye_fov (Condemned 2's own
+// tangents) and dk_xr_pair_sample, sampling the head once per pair the way the game will.
+//
+// Passes (exit 0) when frames were submitted, every pair found its head sample, and nothing failed.
+// Usage: xr_host_test.exe [frames]
+
+#include <windows.h>
+#include <d3d12.h>
+#include <dxgi1_4.h>
+#include <wrl/client.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+#include "rex/graphics/d3d12/xr_output.h"
+
+using Microsoft::WRL::ComPtr;
+using rex::graphics::d3d12::XrOutput;
+
+namespace {
+
+constexpr uint32_t kW = 1280, kH = 720;
+constexpr uint32_t kRingPairs = 64;
+uint32_t g_pair_ids[kRingPairs] = {};
+uint32_t g_pair_of[kRingPairs] = {};
+int g_off = 0, g_draw_failed = 0, g_samples_ok = 0;
+std::string g_last_report;
+
+void LogLine(const char* line) {
+  std::printf("%s\n", line);
+  if (std::strstr(line, "[XR] OFF")) ++g_off;
+  if (std::strstr(line, "draw failed")) ++g_draw_failed;
+  if (std::strstr(line, "frames=")) g_last_report = line;
+}
+
+ComPtr<ID3D12Resource> MakeEye(ID3D12Device* dev, ID3D12CommandQueue* q, float red, float green,
+                               float blue) {
+  D3D12_HEAP_PROPERTIES heap = {D3D12_HEAP_TYPE_DEFAULT};
+  D3D12_RESOURCE_DESC d = {};
+  d.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  d.Width = kW;
+  d.Height = kH;
+  d.DepthOrArraySize = 1;
+  d.MipLevels = 1;
+  d.Format = DXGI_FORMAT_R10G10B10A2_UNORM;
+  d.SampleDesc.Count = 1;
+  d.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+  D3D12_CLEAR_VALUE cv = {d.Format, {red, green, blue, 1.0f}};
+  ComPtr<ID3D12Resource> tex;
+  if (FAILED(dev->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &d,
+                                          D3D12_RESOURCE_STATE_RENDER_TARGET, &cv,
+                                          IID_PPV_ARGS(&tex))))
+    return nullptr;
+  ComPtr<ID3D12DescriptorHeap> rtv_heap;
+  D3D12_DESCRIPTOR_HEAP_DESC hd = {D3D12_DESCRIPTOR_HEAP_TYPE_RTV, 1};
+  dev->CreateDescriptorHeap(&hd, IID_PPV_ARGS(&rtv_heap));
+  dev->CreateRenderTargetView(tex.Get(), nullptr, rtv_heap->GetCPUDescriptorHandleForHeapStart());
+  ComPtr<ID3D12CommandAllocator> a;
+  ComPtr<ID3D12GraphicsCommandList> l;
+  dev->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&a));
+  dev->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, a.Get(), nullptr, IID_PPV_ARGS(&l));
+  l->ClearRenderTargetView(rtv_heap->GetCPUDescriptorHandleForHeapStart(), cv.Color, 0, nullptr);
+  D3D12_RESOURCE_BARRIER b = {};
+  b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  b.Transition.pResource = tex.Get();
+  b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+  b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+  b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;  // where the SDK keeps eye textures
+  l->ResourceBarrier(1, &b);
+  l->Close();
+  ID3D12CommandList* lists[] = {l.Get()};
+  q->ExecuteCommandLists(1, lists);
+  ComPtr<ID3D12Fence> f;
+  dev->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&f));
+  q->Signal(f.Get(), 1);
+  HANDLE ev = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+  f->SetEventOnCompletion(1, ev);
+  WaitForSingleObject(ev, 5000);
+  CloseHandle(ev);
+  return tex;
+}
+
+}  // namespace
+
+// The game program's side (the real ones live in Condemned 2's vr_head_pose.cpp).
+extern "C" __declspec(dllexport) int dk_xr_eye_fov(float t[4]) {
+  t[0] = t[1] = 1.2448f;  // Condemned 2's player view, logged 2026-10-12
+  t[2] = t[3] = 0.7002f;
+  return 1;
+}
+
+extern "C" __declspec(dllexport) int dk_xr_pair_sample(uint32_t pair, uint32_t* id) {
+  const uint32_t slot = pair % kRingPairs;
+  if (g_pair_of[slot] != pair || g_pair_ids[slot] == 0) return 0;
+  *id = g_pair_ids[slot];
+  return 1;
+}
+
+int main(int argc, char** argv) {
+  const int frames = argc > 1 ? std::atoi(argv[1]) : 180;
+  SetEnvironmentVariableA("DK_XR", "1");
+  ComPtr<IDXGIFactory4> factory;
+  ComPtr<IDXGIAdapter1> adapter;
+  ComPtr<ID3D12Device> dev;
+  if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&factory))) ||
+      FAILED(factory->EnumAdapters1(0, &adapter)) ||
+      FAILED(D3D12CreateDevice(adapter.Get(), D3D_FEATURE_LEVEL_11_0, IID_PPV_ARGS(&dev)))) {
+    std::printf("FAIL: no D3D12 device\n");
+    return 2;
+  }
+  D3D12_COMMAND_QUEUE_DESC qd = {D3D12_COMMAND_LIST_TYPE_DIRECT};
+  ComPtr<ID3D12CommandQueue> q;
+  dev->CreateCommandQueue(&qd, IID_PPV_ARGS(&q));
+  ComPtr<ID3D12Resource> left = MakeEye(dev.Get(), q.Get(), 1.0f, 0.0f, 0.0f);
+  ComPtr<ID3D12Resource> right = MakeEye(dev.Get(), q.Get(), 0.0f, 0.0f, 1.0f);
+  if (!left || !right) {
+    std::printf("FAIL: eye textures\n");
+    return 2;
+  }
+
+  XrOutput& xr = XrOutput::Get();
+  xr.SetLog(LogLine);
+  for (int i = 0; i < frames && !g_off; ++i) {
+    const uint32_t pair = uint32_t(i);
+    // As the game will: sample the head when the pair's camera is built (here, just before).
+    uint32_t id = 0;
+    float q4[4], p3[3];
+    if (rex_xr_sample_head(&id, q4, p3)) {
+      ++g_samples_ok;
+      g_pair_of[pair % kRingPairs] = pair;
+      g_pair_ids[pair % kRingPairs] = id;
+      if (g_samples_ok == 1)
+        std::printf("first head sample id=%u q=(%.3f %.3f %.3f %.3f) p=(%.3f %.3f %.3f)\n", id,
+                    q4[0], q4[1], q4[2], q4[3], p3[0], p3[1], p3[2]);
+    }
+    xr.SubmitPair(dev.Get(), q.Get(), left.Get(), right.Get(), kW, kH,
+                  D3D12_RESOURCE_STATE_COPY_SOURCE, pair);
+  }
+  std::printf("RESULT off=%d draw_failed=%d head_samples=%d last: %s\n", g_off, g_draw_failed,
+              g_samples_ok, g_last_report.c_str());
+  const bool pass = !g_off && !g_draw_failed && g_samples_ok > 0 &&
+                    g_last_report.find("draw_errors=0") != std::string::npos;
+  std::printf("%s\n", pass ? "PASS" : "FAIL");
+  return pass ? 0 : 1;
+}
