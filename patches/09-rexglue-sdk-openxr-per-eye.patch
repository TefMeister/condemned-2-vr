diff --git b/src/graphics/d3d12/xr_blit.cpp b/src/graphics/d3d12/xr_blit.cpp
new file mode 100644
index 0000000..9991ce3
--- /dev/null
+++ b/src/graphics/d3d12/xr_blit.cpp
@@ -0,0 +1,241 @@
+// Patch 09 (DK_XR): draws an eye texture into a headset swapchain image. See xr_blit.h.
+//
+// Self-contained (Windows + D3D12 only): d3dcompiler_47.dll and D3D12SerializeRootSignature are
+// looked up at run time, so nothing new is linked and a test program can use this file as is.
+
+#include "xr_blit.h"
+
+#include <d3dcompiler.h>
+
+#include <cstring>
+#include <utility>
+
+namespace rex::graphics::d3d12::xr {
+
+namespace {
+
+// One triangle that covers the screen; the picture is drawn 1:1 (the image is the eye's size).
+// decode (b0.x) undoes sRGB when the target view re-encodes it, so the stored bytes stay the same.
+constexpr char kShader[] = R"(
+cbuffer Params : register(b0) { uint decode; };
+Texture2D<float4> eye : register(t0);
+SamplerState samp : register(s0);
+struct V { float4 pos : SV_Position; float2 uv : TEXCOORD0; };
+V vs_main(uint id : SV_VertexID) {
+  V o;
+  o.uv = float2((id << 1) & 2, id & 2);
+  o.pos = float4(o.uv * float2(2, -2) + float2(-1, 1), 0, 1);
+  return o;
+}
+float3 srgb_to_linear(float3 c) {
+  return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4);
+}
+float4 ps_main(V i) : SV_Target {
+  float3 c = eye.Sample(samp, i.uv).rgb;
+  if (decode != 0) c = srgb_to_linear(c);
+  return float4(c, 1);
+}
+)";
+
+using D3DCompileFn = decltype(&D3DCompile);
+using SerializeRootFn = decltype(&D3D12SerializeRootSignature);
+
+bool Compile(D3DCompileFn compile, const char* entry, const char* target,
+             Microsoft::WRL::ComPtr<ID3DBlob>& out) {
+  Microsoft::WRL::ComPtr<ID3DBlob> errors;
+  return SUCCEEDED(compile(kShader, sizeof(kShader) - 1, "dk_xr_blit", nullptr, nullptr, entry,
+                           target, D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &out, &errors));
+}
+
+D3D12_RESOURCE_BARRIER Transition(ID3D12Resource* r, D3D12_RESOURCE_STATES from,
+                                  D3D12_RESOURCE_STATES to) {
+  D3D12_RESOURCE_BARRIER b = {};
+  b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  b.Transition.pResource = r;
+  b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+  b.Transition.StateBefore = from;
+  b.Transition.StateAfter = to;
+  return b;
+}
+
+}  // namespace
+
+bool EyeBlit::Init(ID3D12Device* device, DXGI_FORMAT rtv_format, bool decode_srgb,
+                   const char** error) {
+  device_ = device;
+  rtv_format_ = rtv_format;
+  decode_srgb_ = decode_srgb;
+
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  auto compile = compiler ? reinterpret_cast<D3DCompileFn>(
+                                reinterpret_cast<void*>(GetProcAddress(compiler, "D3DCompile")))
+                          : nullptr;
+  HMODULE d3d12 = GetModuleHandleW(L"d3d12.dll");
+  auto serialize = d3d12 ? reinterpret_cast<SerializeRootFn>(reinterpret_cast<void*>(
+                               GetProcAddress(d3d12, "D3D12SerializeRootSignature")))
+                         : nullptr;
+  if (!compile || !serialize) {
+    *error = "d3dcompiler_47.dll or D3D12SerializeRootSignature not found";
+    return false;
+  }
+  Microsoft::WRL::ComPtr<ID3DBlob> vs, ps, root_blob, root_err;
+  if (!Compile(compile, "vs_main", "vs_5_0", vs) || !Compile(compile, "ps_main", "ps_5_0", ps)) {
+    *error = "blit shader did not compile";
+    return false;
+  }
+
+  D3D12_DESCRIPTOR_RANGE range = {};
+  range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  range.NumDescriptors = 1;
+  D3D12_ROOT_PARAMETER params[2] = {};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+  params[0].DescriptorTable.NumDescriptorRanges = 1;
+  params[0].DescriptorTable.pDescriptorRanges = &range;
+  params[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+  params[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  params[1].Constants.Num32BitValues = 1;
+  params[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+  D3D12_STATIC_SAMPLER_DESC sampler = {};
+  sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_POINT;  // 1:1, so point keeps every pixel exact
+  sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+  sampler.ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
+  sampler.MaxLOD = D3D12_FLOAT32_MAX;
+  sampler.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+  D3D12_ROOT_SIGNATURE_DESC root_desc = {};
+  root_desc.NumParameters = 2;
+  root_desc.pParameters = params;
+  root_desc.NumStaticSamplers = 1;
+  root_desc.pStaticSamplers = &sampler;
+  if (FAILED(serialize(&root_desc, D3D_ROOT_SIGNATURE_VERSION_1, &root_blob, &root_err)) ||
+      FAILED(device->CreateRootSignature(0, root_blob->GetBufferPointer(),
+                                         root_blob->GetBufferSize(), IID_PPV_ARGS(&root_)))) {
+    *error = "root signature failed";
+    return false;
+  }
+
+  D3D12_GRAPHICS_PIPELINE_STATE_DESC pso = {};
+  pso.pRootSignature = root_.Get();
+  pso.VS = {vs->GetBufferPointer(), vs->GetBufferSize()};
+  pso.PS = {ps->GetBufferPointer(), ps->GetBufferSize()};
+  D3D12_RENDER_TARGET_BLEND_DESC& blend = pso.BlendState.RenderTarget[0];
+  blend.SrcBlend = blend.SrcBlendAlpha = D3D12_BLEND_ONE;  // blending is off; valid values anyway
+  blend.DestBlend = blend.DestBlendAlpha = D3D12_BLEND_ZERO;
+  blend.BlendOp = blend.BlendOpAlpha = D3D12_BLEND_OP_ADD;
+  blend.LogicOp = D3D12_LOGIC_OP_NOOP;
+  blend.RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+  pso.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_ALWAYS;  // depth is off
+  pso.SampleMask = UINT_MAX;
+  pso.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+  pso.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+  pso.RasterizerState.DepthClipEnable = TRUE;
+  pso.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+  pso.NumRenderTargets = 1;
+  pso.RTVFormats[0] = rtv_format;
+  pso.SampleDesc.Count = 1;
+  if (FAILED(device->CreateGraphicsPipelineState(&pso, IID_PPV_ARGS(&pso_)))) {
+    *error = "pipeline state failed";
+    return false;
+  }
+
+  D3D12_DESCRIPTOR_HEAP_DESC srv = {D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV, kFramesInFlight * 2,
+                                    D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE, 0};
+  D3D12_DESCRIPTOR_HEAP_DESC rtv = {D3D12_DESCRIPTOR_HEAP_TYPE_RTV, 2,
+                                    D3D12_DESCRIPTOR_HEAP_FLAG_NONE, 0};
+  if (FAILED(device->CreateDescriptorHeap(&srv, IID_PPV_ARGS(&srv_heap_))) ||
+      FAILED(device->CreateDescriptorHeap(&rtv, IID_PPV_ARGS(&rtv_heap_)))) {
+    *error = "descriptor heaps failed";
+    return false;
+  }
+  srv_step_ = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  rtv_step_ = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+
+  for (auto& a : alloc_) {
+    if (FAILED(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&a)))) {
+      *error = "command allocator failed";
+      return false;
+    }
+  }
+  if (FAILED(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, alloc_[0].Get(),
+                                       nullptr, IID_PPV_ARGS(&list_))) ||
+      FAILED(list_->Close()) ||
+      FAILED(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&fence_)))) {
+    *error = "command list or fence failed";
+    return false;
+  }
+  fence_event_ = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+  return fence_event_ != nullptr;
+}
+
+bool EyeBlit::Draw(ID3D12CommandQueue* queue, ID3D12Resource* const src[2],
+                   D3D12_RESOURCE_STATES src_state, ID3D12Resource* const dst[2], uint32_t width,
+                   uint32_t height, const char** error) {
+  const uint32_t slot = frame_ % kFramesInFlight;
+  if (fence_->GetCompletedValue() < slot_value_[slot]) {
+    fence_->SetEventOnCompletion(slot_value_[slot], fence_event_);
+    WaitForSingleObject(fence_event_, 1000);
+  }
+  if (FAILED(alloc_[slot]->Reset()) || FAILED(list_->Reset(alloc_[slot].Get(), pso_.Get()))) {
+    *error = "command list reset failed";
+    return false;
+  }
+
+  const D3D12_RESOURCE_STATES kRead = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+  D3D12_RESOURCE_BARRIER to_read[2];
+  uint32_t n = 0;
+  to_read[n++] = Transition(src[0], src_state, kRead);
+  if (src[1] != src[0]) to_read[n++] = Transition(src[1], src_state, kRead);
+  if (src_state != kRead) list_->ResourceBarrier(n, to_read);
+
+  ID3D12DescriptorHeap* heaps[] = {srv_heap_.Get()};
+  list_->SetDescriptorHeaps(1, heaps);
+  list_->SetGraphicsRootSignature(root_.Get());
+  list_->SetGraphicsRoot32BitConstant(1, decode_srgb_ ? 1u : 0u, 0);
+  list_->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+  const D3D12_VIEWPORT vp = {0.0f, 0.0f, float(width), float(height), 0.0f, 1.0f};
+  const D3D12_RECT sc = {0, 0, LONG(width), LONG(height)};
+  list_->RSSetViewports(1, &vp);
+  list_->RSSetScissorRects(1, &sc);
+
+  for (int e = 0; e < 2; ++e) {
+    D3D12_CPU_DESCRIPTOR_HANDLE srv_cpu = srv_heap_->GetCPUDescriptorHandleForHeapStart();
+    D3D12_GPU_DESCRIPTOR_HANDLE srv_gpu = srv_heap_->GetGPUDescriptorHandleForHeapStart();
+    srv_cpu.ptr += SIZE_T(slot * 2 + e) * srv_step_;
+    srv_gpu.ptr += UINT64(slot * 2 + e) * srv_step_;
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {};
+    sv.Format = src[e]->GetDesc().Format;
+    sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sv.Texture2D.MipLevels = 1;
+    device_->CreateShaderResourceView(src[e], &sv, srv_cpu);
+
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv = rtv_heap_->GetCPUDescriptorHandleForHeapStart();
+    rtv.ptr += SIZE_T(e) * rtv_step_;
+    D3D12_RENDER_TARGET_VIEW_DESC rv = {};
+    rv.Format = rtv_format_;
+    rv.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2D;
+    device_->CreateRenderTargetView(dst[e], &rv, rtv);
+
+    list_->OMSetRenderTargets(1, &rtv, FALSE, nullptr);
+    list_->SetGraphicsRootDescriptorTable(0, srv_gpu);
+    list_->DrawInstanced(3, 1, 0, 0);
+  }
+
+  if (src_state != kRead) {
+    for (uint32_t i = 0; i < n; ++i) {
+      std::swap(to_read[i].Transition.StateBefore, to_read[i].Transition.StateAfter);
+    }
+    list_->ResourceBarrier(n, to_read);
+  }
+  if (FAILED(list_->Close())) {
+    *error = "command list close failed";
+    return false;
+  }
+  ID3D12CommandList* lists[] = {list_.Get()};
+  queue->ExecuteCommandLists(1, lists);
+  slot_value_[slot] = next_value_;
+  queue->Signal(fence_.Get(), next_value_++);
+  ++frame_;
+  return true;
+}
+
+}  // namespace rex::graphics::d3d12::xr
diff --git b/src/graphics/d3d12/xr_blit.h b/src/graphics/d3d12/xr_blit.h
new file mode 100644
index 0000000..2fa9393
--- /dev/null
+++ b/src/graphics/d3d12/xr_blit.h
@@ -0,0 +1,46 @@
+// Patch 09 (DK_XR): draws an eye texture into a headset swapchain image. A draw rather than a copy,
+// because the game's output is 10:10:10:2 and headsets offer 8-bit sRGB images.
+#pragma once
+
+#include <cstdint>
+
+#include <windows.h>
+#include <d3d12.h>
+#include <wrl/client.h>
+
+namespace rex::graphics::d3d12::xr {
+
+class EyeBlit {
+ public:
+  static constexpr uint32_t kFramesInFlight = 3;
+
+  // rtv_format: the format to draw with (the image's own, or its non-sRGB twin for a typeless image).
+  // decode_srgb: the image is drawn through an sRGB view, so undo the picture's own gamma first.
+  bool Init(ID3D12Device* device, DXGI_FORMAT rtv_format, bool decode_srgb, const char** error);
+
+  // Records and runs, on `queue`, both eyes for one frame: src[e] (in src_state) -> dst[e] (in
+  // RENDER_TARGET, as OpenXR hands D3D12 images out). Waits for the GPU only when every slot
+  // is still busy. Render-target views are read when recorded, so two are enough.
+  bool Draw(ID3D12CommandQueue* queue, ID3D12Resource* const src[2],
+            D3D12_RESOURCE_STATES src_state, ID3D12Resource* const dst[2], uint32_t width,
+            uint32_t height, const char** error);
+
+ private:
+  Microsoft::WRL::ComPtr<ID3D12Device> device_;
+  Microsoft::WRL::ComPtr<ID3D12RootSignature> root_;
+  Microsoft::WRL::ComPtr<ID3D12PipelineState> pso_;
+  Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> srv_heap_;  // kFramesInFlight * 2, shader-visible
+  Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> rtv_heap_;  // 2, one per eye
+  Microsoft::WRL::ComPtr<ID3D12CommandAllocator> alloc_[kFramesInFlight];
+  Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList> list_;
+  Microsoft::WRL::ComPtr<ID3D12Fence> fence_;
+  HANDLE fence_event_ = nullptr;
+  uint64_t slot_value_[kFramesInFlight] = {};
+  uint64_t next_value_ = 1;
+  uint32_t frame_ = 0;
+  uint32_t srv_step_ = 0, rtv_step_ = 0;
+  DXGI_FORMAT rtv_format_ = DXGI_FORMAT_UNKNOWN;
+  bool decode_srgb_ = false;
+};
+
+}  // namespace rex::graphics::d3d12::xr
